{
  "name": "code-review-action",
  "version": "0.7.0",
  "private": true,
  "description": "Review pull requests on Archestra Agent Runtimes and apply fixes on request",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "schemas": "node scripts/build.mjs --scripts && node .build/gen-schemas.js",
    "check:schemas": "npm run schemas && git diff --exit-code -- schemas",
    "local-run": "node scripts/build.mjs --scripts && node .build/local-run.js",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "msw": "3.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
