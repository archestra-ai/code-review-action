{
  "$id": "review.schema.json",
  "title": "review.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "comment",
        "request_changes"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "findings": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Path relative to the repository root"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Line in the head version of the file"
          },
          "end_line": {
            "description": "Last line of a multi-line finding",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "nit"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "One sentence"
          },
          "failure_scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Input or state, and the incorrect result"
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What to change, in one or two sentences; the fix mode implements it"
          },
          "suggestion": {
            "description": "Full replacement text for lines line..end_line",
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "file",
          "line",
          "severity",
          "summary",
          "failure_scenario",
          "recommendation"
        ]
      }
    },
    "previous": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed",
              "still_present",
              "regressed"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    }
  },
  "required": [
    "verdict",
    "summary",
    "findings"
  ]
}
