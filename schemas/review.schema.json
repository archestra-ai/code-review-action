{
  "$id": "review.schema.json",
  "title": "review.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "comment",
        "request_changes"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 12000
    },
    "reviewed": {
      "description": "What the review covered, in order: an area and its key files for each entry",
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "findings": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Path relative to the repository root"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Line in the head version of the file"
          },
          "end_line": {
            "description": "Last line of a multi-line finding",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "nit"
            ]
          },
          "title": {
            "description": "A short name for the finding, used as its heading",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "One sentence"
          },
          "failure_scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Input or state, the incorrect result, and the reasoning a maintainer needs"
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What to change, in one or two sentences; the fix mode implements it"
          },
          "suggestion": {
            "description": "Full replacement text for lines line..end_line",
            "type": "string",
            "maxLength": 4000
          },
          "previous_id": {
            "description": "The id from previous-findings.json when this finding was reported before",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "file",
          "line",
          "severity",
          "summary",
          "failure_scenario",
          "recommendation"
        ]
      }
    },
    "changes": {
      "description": "The places a rule of the change reached, for the change map",
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Path relative to the repository root"
          },
          "line": {
            "description": "The line that matters, when one does",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "What changed there, in one line"
          }
        },
        "required": [
          "file",
          "what"
        ]
      }
    },
    "observations": {
      "description": "What the change does right, and facts a maintainer should know that need no change",
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "tests": {
      "description": "The test files of the change",
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Path relative to the repository root"
          },
          "focus": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "What the file covers, in one line"
          }
        },
        "required": [
          "file",
          "focus"
        ]
      }
    },
    "coverage": {
      "description": "What the tests cover and what they leave out",
      "type": "string",
      "maxLength": 6000
    },
    "limitations": {
      "description": "What the review could not do, and why",
      "type": "string",
      "maxLength": 6000
    },
    "conclusion": {
      "description": "The closing judgement, naming the most actionable finding",
      "type": "string",
      "maxLength": 6000
    },
    "previous": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "fixed",
              "still_present",
              "regressed"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    }
  },
  "required": [
    "verdict",
    "summary",
    "findings"
  ]
}
