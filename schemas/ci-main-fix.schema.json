{
  "$id": "ci-main-fix.schema.json",
  "title": "ci-main-fix.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string",
      "pattern": "^archestra\\/fix-ci-[a-z0-9][a-z0-9-]{0,80}$"
    },
    "commits": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "root_cause": {
      "type": "string",
      "maxLength": 4000
    },
    "reproduction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "branch",
    "commits",
    "summary",
    "reproduction"
  ]
}
