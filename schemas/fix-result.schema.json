{
  "$id": "fix-result.schema.json",
  "title": "fix-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "applied": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "finding",
          "commit"
        ]
      }
    },
    "skipped": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "finding",
          "reason"
        ]
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "required": [
    "applied",
    "skipped",
    "notes"
  ]
}
